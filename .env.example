# Copy to .env; never commit real keys. Existing environment variables take precedence.
RPC_URL=https://ethereum-rpc.publicnode.com
CHAIN_ID=1
SCAN_BLOCKS=1
CONFIRMATIONS=2
SCAN_CONCURRENCY=4
RPC_TIMEOUT_MS=15000
# ETHERSCAN_API_KEY=
# If a proxy is set here, enable Node environment proxy handling as well.
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:1082
